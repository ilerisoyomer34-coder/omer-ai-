{
  "name": "drift-kumanda",
  "productName": "Drift Kumanda",
  "version": "1.0.0",
  "description": "Bluetooth robot kumandası: mBot2, mBot, LEGO BOOST/Technic, SPIKE ve Arduino arabalar",
  "main": "main.js",
  "author": "Ömer",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.omer.driftkumanda",
    "productName": "Drift Kumanda",
    "files": ["main.js", "preload.js", "web/**", "icon.png"],
    "directories": { "output": "dist" },
    "win": {
      "icon": "icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Drift Kumanda",
      "artifactName": "DriftKumanda-Kurulum.exe"
    },
    "portable": {
      "artifactName": "DriftKumanda-Tasinabilir.exe"
    }
  }
}
